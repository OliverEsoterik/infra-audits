{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit Orchestrator State",
  "type": "object",
  "required": ["status", "routing"],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "SCOPING", "PLANNING", "CONFIRM", "COLLECTING",
        "EVALUATING", "AGGREGATING", "REPORTING",
        "ERROR", "COMPLETE"
      ]
    },
    "user_request": { "type": "string" },
    "client_id": { "type": "string" },
    "routing": {
      "type": "object",
      "required": ["last_node", "next_node", "reason"],
      "properties": {
        "last_node": { "type": "string" },
        "next_node": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "decomposition": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "target": { "type": "string" },
              "domain": { "type": "string" },
              "skills": { "type": "array", "items": { "type": "string" } },
              "benchmarks": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "source": { "type": "string", "enum": ["skill-match", "client-config", "generic"] }
      }
    },
    "skill_index": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "description": { "type": "string" },
          "type": { "type": "string", "enum": ["graph", "methodology"] },
          "nodes": { "type": "array", "items": { "type": "string" } },
          "connectors": { "type": "array", "items": { "type": "string" } },
          "benchmarks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "benchmark_index": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "targets": { "type": "array", "items": { "type": "string" } },
          "control_count": { "type": "integer" }
        }
      }
    },
    "client_config": {
      "type": "object",
      "properties": {
        "scoping": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "domain": { "type": "string" },
                  "target": { "type": "string" },
                  "sub_targets": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "benchmarks": {
          "type": "object",
          "properties": {
            "selected": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "graph_topologies": { "type": "array" },
    "selected_topology": { "type": "integer" },
    "nodes": { "type": "object" },
    "_dependencies": { "type": "object" },
    "_graph_routes": { "type": "object" },
    "graph_errors": { "type": "array", "items": { "type": "string" } }
  }
}